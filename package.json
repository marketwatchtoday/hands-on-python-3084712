{
  "name": "tennis-tournament-app",
  "version": "1.0.0",
  "description": "App per gestire tornei di tennis doppio misto",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "install-all": "npm install && cd client && npm install",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "uuid": "^9.0.1",
    "concurrently": "^7.6.0",
    "nodemon": "^3.0.2"
  },
  "keywords": ["tennis", "tournament", "doppio misto", "gestionale"],
  "author": "Tennis Tournament Manager",
  "license": "MIT"
}